# Copy to .env and adjust. Every value has a working default, so
# `docker compose up --build` also works without a .env file.

# --- Database (PostgreSQL 16 + pgvector) ---
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio

# --- GitHub projects ---
GITHUB_USERNAME=Ronald-Nguyen
# Optional personal access token (no scopes needed for public repos).
# Raises the GitHub API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
# Number of most recently updated repositories to fetch
GITHUB_REPO_LIMIT=10
# How often the backend refreshes repositories and re-indexes READMEs
GITHUB_REFRESH_HOURS=6

# --- Backend ---
# Comma separated origins allowed to call the API directly (Vite dev server etc.)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Host ports ---
FRONTEND_PORT=3000
BACKEND_PORT=9080
